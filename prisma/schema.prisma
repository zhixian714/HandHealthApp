generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN   // 第一種:看全部醫院/診所的統計,不登記 moment
  REGION_ADMIN  // 第二種:只看自己管理單位底下的診所統計,不登記 moment
  AUDITOR       // 第三種:只能登記 moment,只看自己診所的統計
}

enum Activity {
  RUB
  WASH
  MISS
}

enum GloveStatus {
  ON
  OFF
  CONT
}

// 管理單位:例如「北區管理處」,底下掛多間診所
// SUPER_ADMIN 不需要綁定任何一個 Organization(視為全區權限)
model Organization {
  id      String   @id @default(cuid())
  name    String

  clinics Clinic[]
  admins  User[]   // 屬於這個管理單位的 REGION_ADMIN 使用者

  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(AUDITOR)

  // AUDITOR 必填;SUPER_ADMIN / REGION_ADMIN 不需要,故改為選填
  clinicId  String?
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])

  // 只有 REGION_ADMIN 會用到,綁定他所管理的單位
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  moments   Moment[]
  sessions  AuditSession[]

  createdAt DateTime @default(now())
}

model Clinic {
  id       String         @id @default(cuid())
  name     String

  // 這間診所屬於哪個管理單位;沒有的話代表尚未分配
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  users    User[]
  moments  Moment[]
  sessions AuditSession[]
}

model StaffCode {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  moments     Moment[]
}

model AuditSession {
  id        String     @id @default(cuid())
  date      DateTime
  startTime DateTime
  endTime   DateTime?

  clinicId  String
  clinic    Clinic     @relation(fields: [clinicId], references: [id])

  auditorId String
  auditor   User       @relation(fields: [auditorId], references: [id])

  moments   Moment[]

  createdAt DateTime   @default(now())
}

model Moment {
  id          String       @id @default(cuid())
  momentNo    Int
  activity    Activity

  // 手套狀態改為選填,對應前端表單的調整
  gloveStatus GloveStatus?

  staffCodeId String
  staffCode   StaffCode    @relation(fields: [staffCodeId], references: [id])

  clinicId    String
  clinic      Clinic       @relation(fields: [clinicId], references: [id])

  auditorId   String
  auditor     User         @relation(fields: [auditorId], references: [id])

  sessionId   String
  session     AuditSession @relation(fields: [sessionId], references: [id])

  createdAt   DateTime     @default(now())
}
