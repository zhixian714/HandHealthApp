generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN   // 第一種:看全部醫院/診所的統計,不登記表單
  REGION_ADMIN  // 第二種:只看自己管理單位底下的診所統計,不登記表單
  AUDITOR       // 第三種:登記表單,只看自己診所的統計
}

enum Activity {
  RUB
  WASH
  MISS
}

enum GloveStatus {
  ON
  OFF
  CONT
}

// 管理單位:例如「江碧雲督導區」,底下掛多間診所
model Organization {
  id      String   @id @default(cuid())
  name    String

  clinics Clinic[]
  admins  User[]

  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(AUDITOR)

  clinicId  String?
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  moments             Moment[]
  sessions            AuditSession[]
  sharpsObservations  SharpsObservation[]
  ppeObservations     PpeObservation[]

  createdAt DateTime @default(now())
}

model Clinic {
  id       String         @id @default(cuid())
  name     String

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  users    User[]
  moments  Moment[]
  sessions AuditSession[]

  sharpsObservations SharpsObservation[]
  ppeObservations    PpeObservation[]
}

model StaffCode {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  moments     Moment[]
}

model AuditSession {
  id        String     @id @default(cuid())
  date      DateTime
  startTime DateTime
  endTime   DateTime?

  clinicId  String
  clinic    Clinic     @relation(fields: [clinicId], references: [id])

  auditorId String
  auditor   User       @relation(fields: [auditorId], references: [id])

  moments   Moment[]

  createdAt DateTime   @default(now())
}

// ---- 表單一:手部衛生稽核(原本就有) ----
model Moment {
  id          String       @id @default(cuid())
  momentNo    Int
  activity    Activity
  gloveStatus GloveStatus?

  staffCodeId String
  staffCode   StaffCode    @relation(fields: [staffCodeId], references: [id])

  clinicId    String
  clinic      Clinic       @relation(fields: [clinicId], references: [id])

  auditorId   String
  auditor     User         @relation(fields: [auditorId], references: [id])

  sessionId   String
  session     AuditSession @relation(fields: [sessionId], references: [id])

  createdAt   DateTime     @default(now())
}

// ---- 表單二:尖銳物安全使用及處置,3 題皆必填 ----
model SharpsObservation {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  auditorId String
  auditor   User   @relation(fields: [auditorId], references: [id])

  // 三題,對應紙本表格的三個欄位
  carriedToPointOfCare Boolean // 尖銳物攜至照護點使用
  noRecapping          Boolean // 不回套
  needleNotOnSurface   Boolean // 針頭不置於工作區表面

  observedAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

// ---- 表單三:個人防護裝備(PPE),5 題皆必填,同一次觀察一起記 ----
model PpeObservation {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  auditorId String
  auditor   User   @relation(fields: [auditorId], references: [id])

  // 暴露前 3 題
  maskWorn    Boolean // 配戴口罩(或護目鏡加口罩)
  gownWorn    Boolean // 穿圍裙或隔離衣
  glovesWorn  Boolean // 戴手套

  // 暴露後 2 題
  gownRemovedBeforeNextPatient Boolean // 接觸下一位病患前立即移除並丟棄圍裙/隔離衣
  glovesRemovedAfterProcedure  Boolean // 執行程序後或暴露後立即移除手套

  observedAt DateTime @default(now())
  createdAt  DateTime @default(now())
}
